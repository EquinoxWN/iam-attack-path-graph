{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheAuditorWithTheExternalId",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::123456789012:user/auditor"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {"sts:ExternalId": "EXAMPLE-NOT-A-SECRET"},
        "Bool": {"aws:MultiFactorAuthPresent": "true"}
      }
    }
  ]
}
